# Use scripts/install.sh: ele gera segredos diferentes em cada instalação.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
JWT_SECRET=GENERATE_JWT_SECRET

# Geração: openai (Responses API) ou deepinfra (Chat Completions com ferramentas).
LLM_PROVIDER=openai
# OPENAI_API_KEY também é obrigatória com DeepInfra por causa dos embeddings.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=XiaomiMiMo/MiMo-V2.6-Pro

# O índice distribuído usa text-embedding-3-small (1536 dimensões).
# Não troque o modelo de embeddings sem reconstruir o índice.
INDEX_DOWNLOAD_URL=https://drive.google.com/uc?id=1Uf2UyfctklI1kzE6k1j927m0yiFyucSc
# Opcional: SHA-256 publicado por quem distribui o índice.
INDEX_SHA256=

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5173

# O cadastro/login por e-mail funciona sem estes serviços opcionais.
GOOGLE_CLIENT_ID=
TAVILY_API_KEY=
